# Copy to .env and adjust.

# Markdown vault root (required)
BRAIN_VAULT=./vault

# Qdrant vector database
BRAIN_QDRANT_HOST=127.0.0.1
BRAIN_QDRANT_PORT=6333

# Embedding service
BRAIN_EMBED_URL=http://127.0.0.1:8091/embed
BRAIN_EMBED_PORT=8091

# Dashboard (optional)
BRAIN_DASHBOARD_HOST=127.0.0.1
BRAIN_DASHBOARD_PORT=8090
BRAIN_AGENT_LOGS=./agentlogs

# Remote SSH stdio
# BRAIN_SSH_HOST=user@host
# BRAIN_SSH_KEY=~/.ssh/id_ed25519
# BRAIN_REMOTE_PYTHON=/opt/brain-mcp/.venv/bin/brain-mcp
