[Unit]
Description=Brain dashboard
After=network.target

[Service]
Type=simple
Environment=BRAIN_VAULT=/data/vault
Environment=BRAIN_AGENT_LOGS=/data/agentlogs
Environment=BRAIN_DASHBOARD_PORT=8090
ExecStart=/opt/brain-mcp/.venv/bin/brain-dashboard
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
